# Copy to .env and adjust. Every value has a safe development default.
ENVIRONMENT=development
# DATABASE_URL=postgresql+asyncpg://dineos:dineos@localhost:5432/dineos
# REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=*
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Payments: mock (default) or razorpay
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxx
# RAZORPAY_WEBHOOK_SECRET=xxx

# WhatsApp: console (default, logs messages) or meta (WhatsApp Cloud API)
WHATSAPP_PROVIDER=console
# WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_INVOICE_TEMPLATE=invoice_document
# WHATSAPP_TEMPLATE_LANGUAGE=en

SEED_DEMO=true
